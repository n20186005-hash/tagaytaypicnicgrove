---
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqJsonLd } from '../data/faq';
import { gallery, heroImage, heroImageOg } from '../data/gallery';
import { itineraryPool } from '../data/itinerary';
import { nearbyFood } from '../data/food';
import { nearbySpots } from '../data/nearby';
import { transport } from '../data/transport';
import { feesAndTickets } from '../data/fees';
import { bestTime } from '../data/best-time';
import { attraction, mapsUrl, mapsEmbedSrc } from '../config';
---

<BaseLayout faqJsonLd={faqJsonLd} ogImage={heroImageOg}>
  <header class="sticky top-0 z-40 border-b border-forest-200/60 bg-cream/90 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
      <a href="#top" class="flex items-center gap-2">
        <img src="/logo.svg" alt="" width="36" height="36" class="h-9 w-9" />
        <span class="font-serif text-lg font-bold text-forest-800 sm:text-xl">Tagaytay Picnic Grove</span>
      </a>
      <nav class="hidden items-center gap-1 text-sm font-medium text-muted md:flex">
        <a href="#overview" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Overview</a>
        <a href="#fees" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Fees</a>
        <a href="#parking" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Parking</a>
        <a href="#best-time" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Best Time</a>
        <a href="#transport" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Transport</a>
        <a href="#food" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Food</a>
        <a href="#nearby" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Nearby</a>
        <a href="#gallery" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Gallery</a>
        <a href="#faq" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">FAQ</a>
      </nav>
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="hidden rounded-lg bg-sunset-500 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-sunset-600 sm:inline-flex">View on Map</a>
    </div>
  </header>

  <section id="top" class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <img src={heroImage} alt="" class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-b from-forest-950/60 via-forest-950/40 to-forest-950/80"></div>
    </div>
    <div class="mx-auto max-w-7xl px-4 pb-28 pt-20 sm:px-6 lg:px-8 lg:pb-36 lg:pt-28">
      <div class="max-w-3xl text-cream">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm ring-1 ring-white/20 backdrop-blur">Taal Volcano ridge · Tagaytay City, Cavite</span>
        <h1 class="mt-5 font-serif text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">Tagaytay Picnic Grove</h1>
        <p class="mt-5 max-w-2xl text-lg text-cream/90 sm:text-xl">Ridge-top picnic cottages, BBQ with family and barkada, zipline over the ridge, horseback trails, and an unbeatable Taal Volcano view — under two hours from Manila.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-sunset-500 px-5 py-3 text-base font-semibold text-white shadow-lg shadow-sunset-500/30 hover:bg-sunset-600">Get Directions</a>
          <a href="#itinerary" class="inline-flex items-center gap-2 rounded-lg bg-white/10 px-5 py-3 text-base font-semibold text-cream ring-1 ring-white/25 backdrop-blur hover:bg-white/20">Build Your Trip Checklist</a>
        </div>
      </div>
      <div class="mt-14 grid max-w-3xl grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="rounded-xl bg-white/10 p-4 ring-1 ring-white/20 backdrop-blur">
          <div class="text-2xl font-bold text-cream">4.3 ★</div>
          <div class="mt-1 text-xs text-cream/80">Google rating</div>
        </div>
        <div class="rounded-xl bg-white/10 p-4 ring-1 ring-white/20 backdrop-blur">
          <div class="text-2xl font-bold text-cream">13.5 ha</div>
          <div class="mt-1 text-xs text-cream/80">of rolling park</div>
        </div>
        <div class="rounded-xl bg-white/10 p-4 ring-1 ring-white/20 backdrop-blur">
          <div class="text-2xl font-bold text-cream">≈640 m</div>
          <div class="mt-1 text-xs text-cream/80">above sea level</div>
        </div>
        <div class="rounded-xl bg-white/10 p-4 ring-1 ring-white/20 backdrop-blur">
          <div class="text-2xl font-bold text-cream">1.5–2 hr</div>
          <div class="mt-1 text-xs text-cream/80">from Manila (light traffic)</div>
        </div>
      </div>
    </div>
  </section>

  <section id="overview" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="font-serif text-3xl font-bold text-forest-800 sm:text-4xl">About the Grove</h2>
        <p class="mt-4 text-lg leading-relaxed text-muted">Tagaytay Picnic Grove is the city's classic family and barkada destination on the ridge facing Taal Volcano. Come for the cool air, the unobstructed view of the lake and crater, and the simple pleasure of a long Filipino-style picnic with grilled inihaw, cold drinks, and a view you can't get anywhere else near Manila.</p>
        <p class="mt-3 text-lg leading-relaxed text-muted">The park is a short walk or drive from People's Park in the Sky and is usually the first stop visitors make when heading up the ridge. You can do it in a few hours or linger all afternoon — or turn it into a full Tagaytay day with lunch at Mahogany Market and a sunset stroll.</p>
        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-forest-100 bg-white p-5 shadow-sm">
            <div class="text-3xl">🌋</div>
            <h3 class="mt-3 font-semibold text-forest-800">Taal Volcano view</h3>
            <p class="mt-2 text-sm text-muted">The park's west-facing terraces line the caldera rim — bring a camera and stay for the golden-hour light on the volcano island and crater lake.</p>
          </div>
          <div class="rounded-2xl border border-forest-100 bg-white p-5 shadow-sm">
            <div class="text-3xl">🌲</div>
            <h3 class="mt-3 font-semibold text-forest-800">Cool Tagaytay air</h3>
            <p class="mt-2 text-sm text-muted">3–5 °C cooler than Manila at any given hour — especially pleasant December–February, with a real wind off the caldera after 4 PM.</p>
          </div>
          <div class="rounded-2xl border border-forest-100 bg-white p-5 shadow-sm">
            <div class="text-3xl">🍢</div>
            <h3 class="mt-3 font-semibold text-forest-800">Picnic &amp; BBQ culture</h3>
            <p class="mt-2 text-sm text-muted">Rows of nipa-hut cottages with tables, grill areas, and vendors selling charcoal and drinks — bring your own inihaw and make it an event.</p>
          </div>
          <div class="rounded-2xl border border-forest-100 bg-white p-5 shadow-sm">
            <div class="text-3xl">👨‍👩‍👧</div>
            <h3 class="mt-3 font-semibold text-forest-800">Family &amp; kid friendly</h3>
            <p class="mt-2 text-sm text-muted">Playground, pony rides, short horseback trails, gentle cable car, and an easy eco-trail loop — works for every age.</p>
          </div>
        </div>
        <div class="mt-10">
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl bg-forest-700 px-6 py-3 font-semibold text-white shadow hover:bg-forest-800">Open in Google Maps →</a>
        </div>
      </div>
      <aside class="space-y-4">
        <div class="rounded-2xl bg-forest-50 p-6 ring-1 ring-forest-100">
          <h3 class="font-semibold text-forest-800">Quick Info</h3>
          <dl class="mt-4 space-y-4 text-sm">
            <div>
              <dt class="text-muted">Address</dt>
              <dd class="mt-0.5 font-medium text-charcoal">{attraction.address.streetAddress}, {attraction.address.addressLocality}, {attraction.address.addressRegion} {attraction.address.postalCode}</dd>
            </div>
            <div>
              <dt class="text-muted">Hours</dt>
              <dd class="mt-0.5 font-medium text-charcoal">{attraction.openingHours.weekday} · {attraction.openingHours.opens}–{attraction.openingHours.closes}</dd>
            </div>
            <div>
              <dt class="text-muted">Entrance</dt>
              <dd class="mt-0.5 font-medium text-charcoal">{feesAndTickets.entrance.label}: {feesAndTickets.entrance.range}</dd>
            </div>
            <div>
              <dt class="text-muted">Coordinates</dt>
              <dd class="mt-0.5 font-medium text-charcoal">{attraction.lat}, {attraction.lng}</dd>
            </div>
            <div>
              <dt class="text-muted">Operator</dt>
              <dd class="mt-0.5 font-medium text-charcoal">Tagaytay City Government · Tagaytay City Tourism</dd>
            </div>
          </dl>
        </div>
        <div class="rounded-2xl bg-sunset-50 p-6 ring-1 ring-sunset-200">
          <p class="text-sm text-sunset-900">Park hours, entrance fees, cottage availability and activities change without notice. Always double-check the latest posted prices and conditions on Google Maps reviews or the Tagaytay City Tourism socials before you travel.</p>
        </div>
      </aside>
    </div>
  </section>

  <section id="fees" class="bg-forest-50/60 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-serif text-3xl font-bold text-forest-800 sm:text-4xl">Tickets, &amp; Activities</h2>
      <p class="mt-3 max-w-3xl text-muted">{feesAndTickets.disclaimer}</p>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-forest-100">
          <h3 class="font-semibold text-forest-800">{feesAndTickets.entrance.label}</h3>
          <div class="mt-2 font-serif text-3xl font-bold text-sunset-600">{feesAndTickets.entrance.range}</div>
          <p class="mt-3 text-sm text-muted">{feesAndTickets.entrance.note}</p>
        </div>
        <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-forest-100">
          <h3 class="font-semibold text-forest-800">{feesAndTickets.cottages.label}</h3>
          <div class="mt-2 font-serif text-3xl font-bold text-sunset-600">{feesAndTickets.cottages.range}</div>
          <p class="mt-3 text-sm text-muted">{feesAndTickets.cottages.note}</p>
        </div>
      </div>
      <div class="mt-10">
        <h3 class="font-semibold text-forest-800">Activities</h3>
        <div class="mt-4 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-forest-100">
          <table class="w-full text-left text-sm">
            <thead class="bg-forest-700 text-cream">
              <tr>
                <th class="px-5 py-3 font-semibold">Activity</th>
                <th class="px-5 py-3 font-semibold">Reference Rate</th>
                <th class="px-5 py-3 font-semibold">Notes</th>
              </tr>
            </thead>
            <tbody>
              {feesAndTickets.activities.map((a, i) => (
                <tr class:list={["border-t", "border-forest-100", i % 2 ? "bg-forest-50/40" : ""]}>
                  <td class="px-5 py-4 font-medium text-charcoal">{a.label}</td>
                  <td class="px-5 py-4 font-semibold text-sunset-700">{a.range}</td>
                  <td class="px-5 py-4 text-muted">{a.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <div class="mt-10 rounded-2xl bg-lake-50 p-6 ring-1 ring-lake-200">
        <h3 class="font-semibold text-lake-900">{feesAndTickets.payment.label}</h3>
        <ul class="mt-3 list-inside list-disc space-y-1.5 text-sm text-lake-900/90">
          {feesAndTickets.payment.bullets.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="parking" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="font-serif text-3xl font-bold text-forest-800 sm:text-4xl">Parking Info</h2>
    <p class="mt-3 max-w-3xl text-muted">{transport.parking.headline}</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {transport.parking.bullets.map((b) => (
        <li class="flex gap-3 rounded-2xl border border-forest-100 bg-white p-5 shadow-sm">
          <span class="mt-1 flex h-6 w-6 flex-none items-center justify-center rounded-full bg-forest-100 text-sm font-bold text-forest-700">✓</span>
          <span class="text-sm text-charcoal">{b}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="best-time" class="bg-cream py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-serif text-3xl font-bold text-forest-800 sm:text-4xl">Best Time to Visit</h2>
      <p class="mt-3 max-w-3xl text-muted">{bestTime.headline}</p>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        <div class="space-y-4">
          <h3 class="font-semibold text-forest-800">By Season</h3>
          {bestTime.season.map((s) => (
            <article class="rounded-2xl border border-forest-100 bg-white p-5 shadow-sm">
              <div class="flex items-baseline justify-between">
              <h4 class="font-semibold text-charcoal">{s.period}</h4>
              <span class="text-sm font-bold text-sunset-600">{s.rating}</span>
              </div>
              <ul class="mt-3 list-inside list-disc space-y-1 pl-1 text-sm text-muted">
                {s.points.map((p) => <li>{p}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <div class="space-y-4">
          <h3 class="font-semibold text-forest-800">By Day</h3>
          {bestTime.weekday.map((d) => (
            <article class="flex items-start gap-4 rounded-2xl border border-forest-100 bg-white p-5 shadow-sm">
              <div class="flex-1">
              <h4 class="font-semibold text-charcoal">{d.day}</h4>
              <p class="mt-1 text-sm text-muted">{d.point}</p>
              </div>
              <span class="text-xs font-bold text-sunset-600">{d.rating}</span>
            </article>
          ))}
          <div class="mt-6">
            <h3 class="font-semibold text-forest-800">Suggested Stay</h3>
            <div class="mt-3 rounded-2xl bg-forest-50 p-5 ring-1 ring-forest-100">
              <ul class="list-inside list-disc space-y-1.5 text-sm text-muted">
                {bestTime.stay.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </div>
        </div>
        <div class="space-y-4">
          <h3 class="font-semibold text-forest-800">By Hour</h3>
          {bestTime.hourly.map((h) => (
            <article class="rounded-2xl border border-forest-100 bg-white p-5 shadow-sm">
              <div class="flex items-baseline justify-between">
                <h4 class="font-semibold text-charcoal">{h.window}</h4>
                <span class="text-sm font-bold text-sunset-600">{h.rating}</span>
              </div>
              <p class="mt-2 text-sm text-muted">{h.point}</p>
            </article>
          ))}
          <div class="mt-6 rounded-2xl border border-sunset-300 bg-sunset-50 p-5 ring-1 ring-sunset-200">
            <h4 class="font-semibold text-sunset-900">Periods to Avoid</h4>
            <ul class="mt-3 list-inside list-disc space-y-1.5 text-sm text-sunset-900/90">
              {bestTime.avoid.map((x) => <li>{x}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="transport" class="bg-forest-50/60 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-serif text-3xl font-bold text-forest-800 sm:text-4xl">Getting There</h2>
      <p class="mt-3 max-w-3xl text-muted">Driving, bus + jeepney commute, ride-hailing, and airports — all the common ways to reach Picnic Grove from Metro Manila.</p>
      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        <article class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-forest-100">
          <div class="flex items-center gap-3">
            <span class="text-2xl">{transport.driving.icon}</span>
            <h3 class="font-semibold text-forest-800">{transport.driving.title}</h3>
          </div>
          <ul class="mt-4 list-inside list-disc space-y-2 text-sm text-muted">
            {transport.driving.body.map((b) => <li>{b}</li>)}
          </ul>
        </article>
        <article class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-forest-100">
          <div class="flex items-center gap-3">
            <span class="text-2xl">{transport.commute.icon}</span>
            <h3 class="font-semibold text-forest-800">{transport.commute.title}</h3>
          </div>
          <ul class="mt-4 list-inside list-disc space-y-2 text-sm text-muted">
            {transport.commute.body.map((b) => <li>{b}</li>)}
          </ul>
        </article>
        <article class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-forest-100">
          <div class="flex items-center gap-3">
            <span class="text-2xl">{transport.taxiRidehail.icon}</span>
            <h3 class="font-semibold text-forest-800">{transport.taxiRidehail.title}</h3>
          </div>
          <ul class="mt-4 list-inside list-disc space-y-2 text-sm text-muted">
            {transport.taxiRidehail.body.map((b) => <li>{b}</li>)}
          </ul>
        </article>
        <article class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-forest-100">
          <div class="flex items-center gap-3">
            <span class="text-2xl">✈️</span>
            <h3 class="font-semibold text-forest-800">From the Airports</h3>
          </div>
          <div class="mt-4 space-y-5">
            {transport.fromAirport.map((a) => (
              <div>
                <h4 class="flex items-center gap-2 font-medium text-charcoal">{a.icon} {a.title}</h4>
                <ul class="mt-2 list-inside list-disc space-y-1.5 pl-4 text-sm text-muted">
                  {a.body.map((b) => <li>{b}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </article>
      </div>
      <div class="mt-12">
        <h3 class="font-semibold text-forest-800">On the map</h3>
        <div class="mt-4 overflow-hidden rounded-2xl shadow-sm ring-1 ring-forest-100">
          <div class="aspect-video w-full">
            <iframe src={mapsEmbedSrc} title="Tagaytay Picnic Grove — Google Map" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
          </div>
        </div>
        <div class="mt-3">
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-forest-700 hover:text-forest-800">Open larger map in Google Maps →</a>
        </div>
      </div>
    </div>
  </section>

  <section id="food" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="font-serif text-3xl font-bold text-forest-800 sm:text-4xl">Places to Eat Nearby</h2>
    <p class="mt-3 max-w-3xl text-muted">Tagaytay's food strip starts a short drive east along the ridge. Bulalo, classic Filipino, and a handful of destination restaurants.</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {nearbyFood.map((f) => (
        <article class="flex flex-col rounded-2xl border border-forest-100 bg-white p-6 shadow-sm">
          <div class="flex items-start justify-between gap-2">
            <h3 class="font-semibold text-forest-800">{f.name}</h3>
            <span class="flex-none rounded-full bg-forest-100 px-2.5 py-0.5 text-sm font-bold text-forest-700">{f.budget}</span>
          </div>
          <p class="mt-1 text-sm text-muted">{f.type}</p>
          <dl class="mt-4 space-y-2 text-sm">
            <div class="flex gap-2">
              <dt class="w-20 flex-none text-muted">Distance</dt>
              <dd class="text-charcoal">{f.distanceKm} · {f.direction}</dd>
            </div>
          </dl>
          <p class="mt-4 flex-1 text-sm text-muted">{f.reason}</p>
          <a class="mt-5 inline-flex w-full items-center justify-center rounded-lg bg-forest-100 px-4 py-2 text-sm font-semibold text-forest-700 hover:bg-forest-200" href={`https://www.google.com/maps/search/?api=1&query=${f.mapsQuery}`} target="_blank" rel="noopener noreferrer">Open in Maps</a>
        </article>
      ))}
    </div>
  </section>

  <section id="nearby" class="bg-sunset-50/40 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-serif text-3xl font-bold text-forest-800 sm:text-4xl">Other Things to Do Nearby</h2>
      <p class="mt-3 max-w-3xl text-muted">Pair Picnic Grove with one of these for a full day on the ridge.</p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {nearbySpots.map((n) => (
          <article class="flex flex-col rounded-2xl border border-sunset-200 bg-white p-6 shadow-sm">
            <h3 class="font-semibold text-forest-800">{n.name}</h3>
            <p class="mt-1 text-sm text-muted">{n.type}</p>
            <dl class="mt-4 space-y-1 text-sm">
              <div class="flex gap-2">
                <dt class="w-20 flex-none text-muted">Distance</dt>
                <dd class="text-charcoal">{n.distanceKm}</dd>
              </div>
              <div class="flex gap-2">
                <dt class="w-20 flex-none text-muted">Drive</dt>
                <dd class="text-charcoal">{n.driveMinutes}</dd>
              </div>
            </dl>
            <p class="mt-4 flex-1 text-sm text-muted">{n.summary}</p>
            <a class="mt-5 inline-flex w-full items-center justify-center rounded-lg bg-sunset-500 px-4 py-2 text-sm font-semibold text-white hover:bg-sunset-600" href={`https://www.google.com/maps/search/?api=1&query=${n.mapsQuery}`} target="_blank" rel="noopener noreferrer">Get directions</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="gallery" class="bg-forest-950 py-16 text-cream">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-serif text-3xl font-bold sm:text-4xl">Photo Gallery</h2>
      <p class="mt-3 max-w-3xl text-cream/80">Tap any photo to open it full-size.</p>
