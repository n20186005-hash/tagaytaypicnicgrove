<script is:inline>
(function () {
  const KEY = 'tpg_itinerary_v1';
  const load = () => { try { return new Set(JSON.parse(localStorage.getItem(KEY) || '[]')); } catch { return new Set(); } };
  const save = (s) => { try { localStorage.setItem(KEY, JSON.stringify(Array.from(s))); } catch {} };
  const apply = (set) => {
    document.querySelectorAll('[data-itin-check]').forEach((cb) => { cb.checked = set.has(cb.getAttribute('data-itin-check')); });
    document.getElementById('itin-count').textContent = String(set.size);
  };
  const set = load();
  apply(set);
  const updateCount = () => { document.getElementById('itin-count').textContent = String(set.size); };
  document.addEventListener('change', (e) => {
    const id = e.target.getAttribute && e.target.getAttribute('data-itin-check');
    if (!id) return;
    if (e.target.checked) set.add(id); else set.delete(id);
    save(set); updateCount();
  });
  document.getElementById('itin-clear').addEventListener('click', () => {
    set.clear(); save(set); apply(set);
  });
})();
</script>

