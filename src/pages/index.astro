---
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqJsonLd as faqJsonLdEn } from '../data/faq';
import { gallery, heroImage, heroImageOg } from '../data/gallery';
import { mapsUrl, mapsEmbedSrc, entity, googleReviews, attraction } from '../config';
import { getTranslations } from '../i18n';
import type { LanguageCode } from '../i18n/types';
import { getWeatherSnapshot, weatherApiUrl } from '../data/weather';
import { weatherAdviceHtml, weatherSummaryLine } from '../scripts/weather-advice-view';
import {
  activitiesRowsHtml,
  faqHtml,
  feesCardsHtml,
  parkingBulletsHtml,
  parkingHeadline,
  paymentTipsHtml,
  quickInfoHtml,
} from '../scripts/sections-html';

const translations = {
  en: getTranslations('en' as LanguageCode),
  fil: getTranslations('fil' as LanguageCode),
};

const t = translations.en;
const ui = t.ui;
const data = t.data;

/** 天气数据在服务端（构建期）获取并带缓存；页面加载后客户端会再做一次刷新。 */
const weather = await getWeatherSnapshot();
const weatherUrl = weatherApiUrl();
const wc = (code: number) => data.weatherCodes[String(code)] ?? { label: '', icon: '⛅' };
const fmtUpdated = new Date(weather.updatedAt).toLocaleString('en-PH', {
  timeZone: 'Asia/Manila',
  dateStyle: 'medium',
  timeStyle: 'short',
});
---

<BaseLayout faqJsonLd={faqJsonLdEn} ogImage={heroImageOg}>
  <script is:inline set:html={`window.__TRANSLATIONS__ = ${JSON.stringify({
    en: translations.en,
    fil: translations.fil,
  })};`}></script>

  <header class="sticky top-0 z-40 border-b border-forest-200/60 bg-cream/90 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
      <a href="#top" class="flex items-center gap-2">
        <img src="/logo.svg" alt="" width="36" height="36" class="h-9 w-9" />
        <span class="font-serif text-lg font-bold text-forest-800 sm:text-xl">Tagaytay Picnic Grove</span>
      </a>
      <nav class="hidden items-center gap-1 text-sm font-medium text-muted md:flex" data-i18n-nav>
        <a href="#overview" data-i18n="nav.overview" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Overview</a>
        <a href="#fees" data-i18n="nav.fees" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Fees</a>
        <a href="#parking" data-i18n="nav.parking" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Parking</a>
        <a href="#best-time" data-i18n="nav.bestTime" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Best Time</a>
        <a href="#transport" data-i18n="nav.transport" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Transport</a>
        <a href="#food" data-i18n="nav.food" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Food</a>
        <a href="#nearby" data-i18n="nav.nearby" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Nearby</a>
        <a href="#gallery" data-i18n="nav.gallery" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Gallery</a>
        <a href="#reviews" data-i18n="nav.reviews" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Reviews</a>
        <a href="#faq" data-i18n="nav.faq" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">FAQ</a>
        <a href="#weather" data-i18n="nav.weather" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Weather</a>
        <a href="#services" data-i18n="nav.services" class="rounded-lg px-3 py-2 hover:bg-forest-100 hover:text-forest-800">Services</a>
      </nav>
      <div class="flex items-center gap-2">
        <div id="lang-switcher" class="relative">
          <button id="lang-toggle" aria-label="Language" class="flex items-center gap-1.5 rounded-lg border border-forest-200 bg-white px-3 py-2 text-sm font-medium text-forest-800 hover:bg-forest-50">
            <span id="lang-flag" aria-hidden="true">🇺🇸</span>
            <span id="lang-label" class="hidden sm:inline">English</span>
            <svg class="h-3.5 w-3.5 text-muted" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5l3 3 3-3"/></svg>
          </button>
          <div id="lang-menu" class="hidden absolute right-0 mt-1 w-40 overflow-hidden rounded-xl border border-forest-200 bg-white shadow-lg z-50">
            <button data-lang-choice="en" class="flex w-full items-center gap-2 px-3 py-2.5 text-left text-sm hover:bg-forest-50 active-lang">
              <span>🇺🇸</span><span><strong>English</strong><br><span class="text-xs text-muted">English</span></span>
            </button>
            <button data-lang-choice="fil" class="flex w-full items-center gap-2 px-3 py-2.5 text-left text-sm hover:bg-forest-50">
              <span>🇵🇭</span><span><strong>Tagalog</strong><br><span class="text-xs text-muted">Filipino</span></span>
            </button>
          </div>
        </div>
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" data-i18n="nav.viewOnMap" class="hidden rounded-lg bg-sunset-500 px-4 py-2 text-sm font-semibold text-white shadow hover:bg-sunset-600 sm:inline-flex">View on Map</a>
      </div>
    </div>
  </header>

  <section id="top" class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <img
        id="hero-img"
        src={heroImage}
        alt={`${entity.fullName} - Main view in ${entity.cityName}, ${entity.countryName}`}
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-forest-950/60 via-forest-950/40 to-forest-950/80"></div>
    </div>
    <div class="mx-auto max-w-7xl px-4 pb-28 pt-20 sm:px-6 lg:px-8 lg:pb-36 lg:pt-28">
      <div class="max-w-3xl text-cream">
        <span data-i18n="hero.locationTag" class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm ring-1 ring-white/20 backdrop-blur">Taal Volcano ridge · Tagaytay City, Cavite</span>
        <h1 data-i18n="hero.title" class="mt-5 font-serif text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl">Tagaytay Picnic Grove (Tagaytay City)</h1>
        <p data-i18n="hero.subtitle" class="mt-5 max-w-2xl text-lg text-cream/90 sm:text-xl">Ridge-top picnic cottages, BBQ with family and barkada, zipline over the ridge, horseback trails, and an unbeatable Taal Volcano view — under two hours from Manila.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" data-i18n="hero.getDirections" class="inline-flex items-center gap-2 rounded-lg bg-sunset-500 px-5 py-3 text-base font-semibold text-white shadow-lg shadow-sunset-500/30 hover:bg-sunset-600">Get Directions</a>
          <a href="#itinerary" data-i18n="hero.buildChecklist" class="inline-flex items-center gap-2 rounded-lg bg-white/10 px-5 py-3 text-base font-semibold text-cream ring-1 ring-white/25 backdrop-blur hover:bg-white/20">Build Your Trip Checklist</a>
        </div>
      </div>
      <div class="mt-14 grid max-w-3xl grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="rounded-xl bg-white/10 p-4 ring-1 ring-white/20 backdrop-blur">
          <div class="text-2xl font-bold text-cream">{googleReviews.ratingValueDisplay} ★</div>
          <div class="mt-1 text-xs text-cream/80">
            <span data-i18n="hero.stats.googleRating">Google rating</span> · {googleReviews.reviewCountDisplay} <span data-i18n="hero.stats.googleReviews">Google reviews</span>
          </div>
        </div>
        <div class="rounded-xl bg-white/10 p-4 ring-1 ring-white/20 backdrop-blur">
          <div class="text-2xl font-bold text-cream">13.5 ha</div>
          <div data-i18n="hero.stats.rollingPark" class="mt-1 text-xs text-cream/80">of rolling park</div>
        </div>
        <div class="rounded-xl bg-white/10 p-4 ring-1 ring-white/20 backdrop-blur">
          <div class="text-2xl font-bold text-cream">≈640 m</div>
          <div data-i18n="hero.stats.aboveSeaLevel" class="mt-1 text-xs text-cream/80">above sea level</div>
        </div>
        <div class="rounded-xl bg-white/10 p-4 ring-1 ring-white/20 backdrop-blur">
          <div class="text-2xl font-bold text-cream">1.5–2 hr</div>
          <div data-i18n="hero.stats.fromManila" class="mt-1 text-xs text-cream/80">from Manila (light traffic)</div>
        </div>
      </div>
      <p class="mt-4 max-w-3xl text-xs text-cream/70">
        <a href={googleReviews.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline hover:text-cream">
          <span data-i18n="reviews.syncLine">评分与评价数同步自谷歌地图（Google Maps）用户评价 · 2026 年 9 月 · 点击查看谷歌地图全部评价↗</span>
        </a>
      </p>
    </div>
  </section>

  <section id="overview" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap items-center gap-2 text-sm text-muted">
      <span class="font-semibold text-forest-700" data-i18n="breadcrumb.label">You are here</span>
      <span aria-hidden="true">·</span>
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="#top" class="hover:text-forest-800" data-i18n="breadcrumb.home">Guide home</a></li>
        <li aria-hidden="true">→</li>
        <li class="font-medium text-charcoal">{entity.fullName}</li>
        <li aria-hidden="true">→</li>
        <li>{entity.cityName}</li>
        <li aria-hidden="true">→</li>
        <li>{entity.stateProvince}</li>
        <li aria-hidden="true">→</li>
        <li>{entity.countryName}</li>
      </ol>
    </nav>
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 data-i18n="overview.title" class="font-serif text-3xl font-bold text-forest-800 sm:text-4xl">About Tagaytay Picnic Grove</h2>
        <p data-i18n="overview.p0" class="mt-4 text-lg leading-relaxed text-muted">{ui.overview.p0}</p>
        <p data-i18n="overview.p1" class="mt-3 text-lg leading-relaxed text-muted">{ui.overview.p1}</p>
        <p data-i18n="overview.p2" class="mt-3 text-lg leading-relaxed text-muted">{ui.overview.p2}</p>
        <div id="feature-cards" class="mt-10 grid gap-4 sm:grid-cols-2"></div>
        <div class="mt-10">
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" data-i18n="overview.openInMaps" class="inline-flex items-center gap-2 rounded-xl bg-forest-700 px-6 py-3 font-semibold text-white shadow hover:bg-forest-800">Open in Google Maps →</a>
        </div>
      </div>
      <aside class="space-y-4">
        <div class="rounded-2xl bg-forest-50 p-6 ring-1 ring-forest-100">
          <h3 data-i18n="overview.quickInfo.title" class="font-semibold text-forest-800">Quick Info</h3>
          <dl id="quickinfo-list" class="mt-4 space-y-4 text-sm" set:html={quickInfoHtml(ui, data, entity)}></dl>
        </div>
        <div class="rounded-2xl bg-sunset-50 p-6 ring-1 ring-sunset-200">
          <p data-i18n="overview.disclaimer" class="text-sm text-sunset-900">{ui.overview.disclaimer}</p>
        </div>
      </aside>
    </div>
  </section>

  <section id="history" class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 data-i18n="history.title" class="font-serif text-3xl font-bold text-forest-800 sm:text-4xl">History &amp; Significance of Tagaytay Picnic Grove</h2>
      <p data-i18n="history.subtitle" class="mt-3 max-w-3xl text-muted">{ui.history.subtitle}</p>
      <div id="history-paragraphs" class="mt-8 max-w-3xl space-y-4 text-lg leading-relaxed text-muted"></div>
      <div class="mt-10">
        <h3 data-i18n="history.milestonesTitle" class="font-semibold text-forest-800">Timeline</h3>
        <ol id="history-milestones" class="mt-4 space-y-3"></ol>
      </div>
      <div class="mt-12">
        <h3 data-i18n="legends.title" class="font-semibold text-forest-800">{ui.legends.title}</h3>
        <p data-i18n="legends.subtitle" class="mt-2 max-w-3xl text-sm text-muted">{ui.legends.subtitle}</p>
        <div id="legends-list" class="mt-4 grid gap-4 lg:grid-cols-2">
          {data.legends.map((l) => (
            <article class="rounded-2xl border border-forest-100 bg-white p-5 shadow-sm">
              <div class="flex flex-wrap items-center gap-2">
                <h4 class="font-semibold text-forest-800">{l.title}</h4>
                <span class="rounded-full bg-forest-50 px-3 py-1 text-xs font-semibold text-forest-700">{l.kind}</span>
              </div>
              <p class="mt-2 text-sm text-muted">{l.text}</p>
            </article>
          ))}
        </div>
        <p id="legends-note" class="mt-4 max-w-3xl text-xs text-muted">{ui.legends.note}</p>
      </div>
      <p class="mt-8 max-w-3xl text-sm text-muted">
        For official updates and regional tourism information, visit
        <a href={entity.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-forest-700 underline hover:text-forest-800">{entity.govtTourismLabel}</a>.
        Current volcano alert levels are published by
        <a href={entity.phivolcsUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-forest-700 underline hover:text-forest-800">PHIVOLCS</a>.
      </p>
    </div>
  </section>

  <section id="fees" class="bg-forest-50/60 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 data-i18n="fees.title" class="font-serif text-3xl font-bold text-forest-800 sm:text-4xl">Tickets, &amp; Activities</h2>
      <p data-i18n="fees.disclaimer" class="mt-3 max-w-3xl text-muted">{ui.fees.disclaimer}</p>
      <div id="fees-cards" class="mt-8 grid gap-5 md:grid-cols-2" set:html={feesCardsHtml(data)}></div>
      <div class="mt-10">
        <h3 data-i18n="fees.activities.title" class="font-semibold text-forest-800">Activities</h3>
        <div class="mt-4 overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-forest-100">
          <table class="w-full text-left text-sm">
            <thead class="bg-forest-700 text-cream">
              <tr>
                <th data-i18n="fees.activities.activity" class="px-5 py-3 font-semibold">Activity</th>
                <th data-i18n="fees.activities.referenceRate" class="px-5 py-3 font-semibold">Reference Rate</th>
                <th data-i18n="fees.activities.notes" class="px-5 py-3 font-semibold">Notes</th>
              </tr>
            </thead>
            <tbody id="activities-table" set:html={activitiesRowsHtml(data, 'en')}></tbody>
          </table>
        </div>
      </div>
      <div id="payment-tips" class="mt-10 rounded-2xl bg-lake-50 p-6 ring-1 ring-lake-200" set:html={paymentTipsHtml(data)}></div>
    </div>
  </section>

  <section id="parking" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 data-i18n="parking.title" class="font-serif text-3xl font-bold text-forest-800 sm:text-4xl">Parking Info</h2>
    <p id="parking-headline" class="mt-3 max-w-3xl text-muted" set:html={parkingHeadline(data)}></p>
    <ul id="parking-bullets" class="mt-8 grid gap-4 sm:grid-cols-2" set:html={parkingBulletsHtml(data)}></ul>
  </section>

  <section id="best-time" class="bg-cream py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 data-i18n="bestTime.title" class="font-serif text-3xl font-bold text-forest-800 sm:text-4xl">Best Time to Visit</h2>
      <p id="besttime-headline" class="mt-3 max-w-3xl text-muted"></p>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        <div class="space-y-4">
          <h3 data-i18n="bestTime.bySeason" class="font-semibold text-forest-800">By Season</h3>
          <div id="besttime-season" class="space-y-4"></div>
        </div>
        <div class="space-y-4">
          <h3 data-i18n="bestTime.byDay" class="font-semibold text-forest-800">By Day</h3>
          <div id="besttime-weekday" class="space-y-4"></div>
          <div class="mt-6">
            <h3 data-i18n="bestTime.suggestedStay" class="font-semibold text-forest-800">Suggested Stay</h3>
            <div id="besttime-stay" class="mt-3 rounded-2xl bg-forest-50 p-5 ring-1 ring-forest-100"></div>
          </div>
        </div>
        <div class="space-y-4">
          <h3 data-i18n="bestTime.byHour" class="font-semibold text-forest-800">By Hour</h3>
          <div id="besttime-hourly" class="space-y-4"></div>
          <div class="mt-6 rounded-2xl border border-sunset-300 bg-sunset-50 p-5 ring-1 ring-sunset-200">
            <h4 data-i18n="bestTime.periodsToAvoid" class="font-semibold text-sunset-900">Periods to Avoid</h4>
            <ul id="besttime-avoid" class="mt-3 list-inside list-disc space-y-1.5 text-sm text-sunset-900/90"></ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="weather" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 data-i18n="weather.title" class="font-serif text-3xl font-bold text-forest-800 sm:text-4xl">{ui.weather.title}</h2>
    <p data-i18n="weather.subtitle" class="mt-3 max-w-3xl text-muted">{ui.weather.subtitle}</p>

    <div id="weather-current" class="mt-8 grid gap-6 lg:grid-cols-3">
      <div class="rounded-2xl bg-forest-50 p-6 ring-1 ring-forest-100">
        <div class="flex items-center gap-4">
          <span class="text-4xl">{wc(weather.current.weatherCode).icon}</span>
          <div>
            <div class="font-serif text-3xl font-bold text-forest-800">{Math.round(weather.current.temperature)}°C</div>
            <div class="text-sm text-muted">{wc(weather.current.weatherCode).label}</div>
          </div>
        </div>
        <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <div><dt class="text-muted" data-i18n="weather.feelsLike">{ui.weather.feelsLike}</dt><dd class="font-semibold text-charcoal">{Math.round(weather.current.apparentTemperature)}°C</dd></div>
          <div><dt class="text-muted" data-i18n="weather.humidity">{ui.weather.humidity}</dt><dd class="font-semibold text-charcoal">{weather.current.humidity}%</dd></div>
          <div><dt class="text-muted" data-i18n="weather.wind">{ui.weather.wind}</dt><dd class="font-semibold text-charcoal">{weather.current.windSpeed} km/h</dd></div>
          <div><dt class="text-muted" data-i18n="weather.gust">{ui.weather.gust}</dt><dd class="font-semibold text-charcoal">{weather.current.windGust} km/h</dd></div>
        </dl>
      </div>
      <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-forest-100 lg:col-span-2">
        <p class="text-sm font-medium text-charcoal">{weatherSummaryLine(weather, ui.weather, data.weatherCodes)}</p>
        <p class="mt-2 font-semibold text-forest-800">
          {(weather.daily[0]?.precipitationProbability ?? 0) >= 60 ? ui.weather.umbrellaYes : ui.weather.umbrellaNo}
        </p>
        <dl class="mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
          <div><dt class="text-muted" data-i18n="weather.sunrise">{ui.weather.sunrise}</dt><dd class="font-semibold text-charcoal">{weather.daily[0]?.sunrise || '-'}</dd></div>
          <div><dt class="text-muted" data-i18n="weather.sunset">{ui.weather.sunset}</dt><dd class="font-semibold text-charcoal">{weather.daily[0]?.sunset || '-'}</dd></div>
          <div><dt class="text-muted" data-i18n="weather.uv">{ui.weather.uv}</dt><dd class="font-semibold text-charcoal">{weather.daily[0]?.uvIndexMax ?? '-'}</dd></div>
          <div><dt class="text-muted" data-i18n="weather.updated">{ui.weather.updated}</dt><dd class="font-semibold text-charcoal">{fmtUpdated}</dd></div>
        </dl>
        <p class="mt-4 text-sm text-muted" data-i18n="weather.note">{ui.weather.note}</p>
      </div>
    </div>

    <div id="weather-advice" set:html={weatherAdviceHtml(weather, ui.weather, data.weatherAdvice)}></div>

    <h3 data-i18n="weather.forecastTitle" class="mt-10 font-semibold text-forest-800">{ui.weather.forecastTitle}</h3>
    <div id="weather-forecast" class="mt-4 grid gap-3 sm:grid-cols-3 lg:grid-cols-7">
      {weather.daily.map((d) => (
        <div class="rounded-2xl border border-forest-100 bg-white p-4 text-center shadow-sm">
          <div class="text-xs font-semibold text-forest-800">{d.weekday}</div>
          <div class="mt-1 text-xs text-muted">{d.date.slice(5)}</div>
          <div class="mt-2 text-2xl">{wc(d.weatherCode).icon}</div>
          <div class="mt-2 font-semibold text-charcoal">{d.tempMax}° / {d.tempMin}°</div>
          <div class="mt-1 text-xs text-muted">💧 {d.precipitationProbability}%</div>
          <div class="text-xs text-muted">{d.precipitation} mm</div>
        </div>
      ))}
    </div>
  </section>

  <section id="season-strategy" class="bg-forest-50/60 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 data-i18n="seasonStrategy.title" class="font-serif text-3xl font-bold text-forest-800 sm:text-4xl">{ui.seasonStrategy.title}</h2>
      <p data-i18n="seasonStrategy.subtitle" class="mt-3 max-w-3xl text-muted">{ui.seasonStrategy.subtitle}</p>
      <div class="mt-8 overflow-x-auto rounded-2xl bg-white shadow-sm ring-1 ring-forest-100">
        <table class="w-full min-w-[900px] border-collapse text-left text-sm">
          <thead id="season-strategy-head" class="bg-forest-50 text-forest-800">
            <tr>
              <th scope="col" class="px-4 py-3">{ui.seasonStrategy.colSeason}</th>
              <th scope="col" class="px-4 py-3">{ui.seasonStrategy.colWeather}</th>
              <th scope="col" class="px-4 py-3">{ui.seasonStrategy.colVolcano}</th>
